---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import IconRss from "@/assets/icons/IconRss.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Datetime from "@/components/Datetime.astro";

import { useTranslations } from "@/i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const homePath = getRelativeLocaleUrl(locale, "");

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const latestPosts = sortedPosts.slice(0, 6);
---

<Layout>
  <Header />

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <!-- HERO -->
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Neraca
      </h1>

      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        Making economic news easy to understand.
      </p>

      <p class="mt-2">
        Clear and accessible insights on economics, finance, business, and
        financial literacy.
      </p>

      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>

            <Socials />
          </div>
        )
      }
    </section>

    <!-- LATEST ARTICLES -->
    <section class="pt-8 pb-12">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-2xl font-bold sm:text-3xl">
          Latest Articles
        </h2>

        <a
          href={getRelativeLocaleUrl(locale, "archives")}
          class="text-accent text-sm font-medium hover:underline"
        >
          View all →
        </a>
      </div>

      {
        latestPosts.length > 0 ? (
          <div class="grid gap-6">
            {latestPosts.map(post => (
              <article
                class="border-border hover:border-accent rounded-lg border p-5 transition-colors"
              >
                <a href={getPostUrl(post.id, post.filePath, locale)}>
                  <h3 class="text-xl font-bold hover:underline">
                    {post.data.title}
                  </h3>
                </a>

                <div class="text-muted-foreground mt-2 text-sm">
                  <Datetime
                    pubDatetime={post.data.pubDatetime}
                    modDatetime={post.data.modDatetime}
                    timezone={post.data.timezone}
                  />
                </div>

                <p class="text-muted-foreground mt-3">
                  {post.data.description}
                </p>

                <div class="mt-4">
                  <a
                    href={getPostUrl(post.id, post.filePath, locale)}
                    class="text-accent font-medium hover:underline"
                  >
                    Read article →
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <p class="text-muted-foreground">
            No articles published yet.
          </p>
        )
      }
    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;

    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");

    if (indexLayout?.layout) {
      sessionStorage.setItem(
        "backUrl",
        indexLayout.homePath ?? baseRoot
      );
    }
  });
</script>
